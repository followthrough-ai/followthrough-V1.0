# ==== mode ====
FOLLOWTHROUGH_MODE=mock            # mock (default, no keys needed) | real (lets `run.py live` act)

# ==== LLM (agents) ====
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium
GROQ_TEMPERATURE=0.2               # lower = more consistent extraction (1 = more varied)
GROQ_TPM_LIMIT=8000                # tokens/minute for your Groq tier (free tier: 8000)
GROQ_CHUNK_CHARS=16000             # long transcripts are split into parts of this size

# ==== Granola ====
GRANOLA_API_KEY=grn_...
GRANOLA_API_URL=https://public-api.granola.ai/v1

# ==== Google (Gmail + Calendar) ====
GOOGLE_CREDENTIALS_JSON=credentials.json
GOOGLE_TOKEN_JSON=token.json

# ==== Slack ====
SLACK_BOT_TOKEN=xoxb-...

# ==== Airtable ====
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE_NAME=Deals